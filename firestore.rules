rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // The storefront only needs published catalog metadata.
    match /articles/{id} {
      allow read: if resource.data.isAvailable == true || admin();
      allow write: if admin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /users/{uid} { allow read, write: if owner(uid) || admin(); }
    match /orders/{id} {
      // Guest checkout remains supported; server-side validation should still be added before launch.
      allow create: if signedIn() || !('userId' in request.resource.data);
      allow read, update: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if admin();
    }
    match /virtualAdventClaims/{id} { allow read, write: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /coupons/{id} { allow read: if true; allow write: if admin(); }
    match /giftCards/{id} { allow read: if admin(); allow write: if admin(); }
    match /reviews/{id} { allow read: if true; allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid); }
    match /{document=**} { allow read, write: if false; }
  }
}
